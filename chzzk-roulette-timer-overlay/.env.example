# 서버 포트입니다.
# 기본값은 3000입니다.
# 포트를 바꾸면 관리자/오버레이 주소도 같이 바뀝니다.
# 예: PORT=3001 이면 http://localhost:3001/admin
PORT=3000

# 접속 허용 주소입니다.
# 0.0.0.0이면 같은 공유기 안의 다른 PC에서도 접속할 수 있습니다.
# 혼자 쓰는 PC에서만 열고 싶으면 127.0.0.1로 바꿀 수 있습니다.
HOST=0.0.0.0

# 치지직 실제 후원 연동 사용 여부입니다.
# 현재 버전에서는 실제 연동이 아직 구현 전이므로 false로 둡니다.
CHZZK_ENABLED=false

# 아래 값들은 추후 치지직 실제 연동 기능에서 사용할 예정입니다.
# 테스트 모드에서는 비워두면 됩니다.

# 치지직 개발자센터에서 발급받는 Client ID
CHZZK_CLIENT_ID=

# 치지직 개발자센터에서 발급받는 Client Secret
# 다른 사람에게 공유하면 안 됩니다.
CHZZK_CLIENT_SECRET=

# 연동할 치지직 채널 ID
CHZZK_CHANNEL_ID=

# 치지직 API 접근 토큰
CHZZK_ACCESS_TOKEN=
